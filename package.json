{
  "name": "openclaw-interaction-bridge-v2",
  "version": "1.8.0",
  "description": "Bridge OpenClaw agent state directly to snarling display via HTTP API, with Gateway-native approval flow and notification support",
  "main": "index.mjs",
  "type": "module",
  "peerDependencies": {
    "openclaw": "^2026.10.2"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.32.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.10.2",
      "pluginSdkVersion": "2026.10.2"
    }
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=index.mjs --external:openclaw --external:openclaw/*"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
